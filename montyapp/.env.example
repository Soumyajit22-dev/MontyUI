# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser bundle,
# so nothing secret belongs in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Product app users are redirected to after auth.
VITE_APP_URL=https://app.citepark.com

# Razorpay key id — public, and the only half of the pair the browser may see.
# The key secret goes in supabase/.env.local, for the Edge Functions.
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
